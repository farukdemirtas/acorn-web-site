# oakacorn.site — Node upstream portu PM2’deki PORT ile aynı olmalı (üretim: 3030).
# Debian/Ubuntu: /etc/nginx/sites-available/oakacorn → sites-enabled symlink
# certbot --nginx -d oakacorn.site -d www.oakacorn.site

upstream next_oakacorn {
    server 127.0.0.1:3030; # PM2: PORT=3030 ile aynı
    keepalive 64;
}

server {
    listen 80;
    listen [::]:80;
    server_name oakacorn.site www.oakacorn.site;

    location / {
        proxy_pass http://next_oakacorn;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    client_max_body_size 16M;
}
